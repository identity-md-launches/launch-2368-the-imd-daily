# Copy to .env and fill in. Nothing here is secret: the service holds no private key.
# Public hostname of this server (a free subdomain such as DuckDNS works).
FILES_DOMAIN=imd-daily.duckdns.org
# Origin written into every uploaded file URL. Keep it forever: published URLs are on chain.
PUBLIC_FILE_ORIGIN=https://imd-daily.duckdns.org
# Comma-separated site origins allowed to sign in and upload (the IMD site URL, plus a local preview if you use one).
ALLOWED_ORIGINS=https://the-imd-daily.imd.fun
# Largest PDF accepted, in MB.
MAX_PDF_MB=200
