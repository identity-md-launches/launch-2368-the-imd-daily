# FILES_DOMAIN is a hostname you keep, e.g. imd-daily.duckdns.org. Caddy obtains and renews
# a Let's Encrypt certificate for it automatically once ports 80 and 443 reach this server.
{$FILES_DOMAIN} {
	# Serve the immutable files unchanged, including byte-range responses.
	request_body /api/objects/* {
		max_size 210MB
	}
	reverse_proxy files:8080
}
