{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The IMD Daily issue metadata, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "image", "external_url", "properties"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {
      "const": "A collectible copy of The IMD Daily. Ownership conveys no copyright or entitlement to financial returns."
    },
    "image": {"type": "string", "format": "uri", "pattern": "^https://"},
    "external_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "collection_name", "collection_symbol", "chain_id",
        "collection_address", "issue_id", "editorial_date", "editorial_timestamp",
        "pdf_url", "hash_algorithm", "pdf_sha256", "cover_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "collection_name": {"const": "The IMD Daily"},
        "collection_symbol": {"const": "IMDDAILY"},
        "chain_id": {"const": 1},
        "collection_address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "issue_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "editorial_date": {"type": "string", "format": "date"},
        "editorial_timestamp": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "pdf_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "hash_algorithm": {"const": "sha256"},
        "pdf_sha256": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
        "cover_sha256": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
      }
    }
  }
}

